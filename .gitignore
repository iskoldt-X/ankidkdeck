# DDO-derived content and pipeline outputs must never be committed.
*.html
*.mp3
*.json
*.apkg
*.anki2
*.log
wiktionary_danish_wordlist.txt

# Registry files are the ONE tracked exception to the *.json rule above:
# they contain only word identities and rules, never DDO text.
# The negation must be RECURSIVE. `registry/*.json` does not reach the
# subdirectory registry/prompt_packs/, so the four hand-reviewed prompt packs
# were silently unstageable: `git add` exited 0 and added nothing, `git status
# --untracked-files=all` never listed them, and a commit prepared that way
# ships a tree (and a wheel) with no packs at all -- where every RICH prompt
# degrades to LEAN while prompt_id still reports rich-core-1.
!src/ankidkdeck/registry/**/*.json

# Runtime workspace (corpus, parses, ledgers, fixtures) - lives on the run host.
work/
dist/
audio/*
!audio/.gitkeep
ddo_html_all_versions/*
!ddo_html_all_versions/.gitkeep

# Python / OS noise
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
.DS_Store
